class_name TileLoader
extends RefCounted

# Reads the same tile data as the Java renderer.
# Tile metadata lives in res://assets/route/tile_XX.json and the vertex data is
# generated by tools/sync_assets.py into a single little-endian gzip blob
# res://assets/route/tile_XX.mesh.bin.gz (six float32 per vertex: XYZRGB).

const ROUTE_DIR := "res://assets/route/"

static func load_json(path: String) -> Dictionary:
	var text := FileAccess.get_file_as_string(path)
	if text == "":
		push_error("Missing " + path)
		return {}
	var data = JSON.parse_string(text)
	if typeof(data) != TYPE_DICTIONARY:
		push_error("Invalid JSON " + path)
		return {}
	return data


static func load_region() -> Dictionary:
	return load_json(ROUTE_DIR + "region.json")


static func load_tile_meta(tile_id: String) -> Dictionary:
	return load_json(ROUTE_DIR + tile_id + ".json")


static func load_tile_mesh(tile_id: String) -> ArrayMesh:
	var raw := FileAccess.get_file_as_bytes(ROUTE_DIR + tile_id + ".mesh.bin.gz")
	if raw.is_empty():
		push_error("Missing mesh blob for " + tile_id)
		return null
	var buf := raw.decompress_dynamic(1 << 30, FileAccess.COMPRESSION_GZIP)
	if buf.is_empty():
		push_error("Failed to decompress " + tile_id)
		return null
	var floats := buf.to_float32_array()
	var vert_count := floats.size() / 6
	if vert_count <= 0:
		push_error("Empty mesh " + tile_id)
		return null

	var positions := PackedVector3Array()
	var colors := PackedColorArray()
	positions.resize(vert_count)
	colors.resize(vert_count)
	var j := 0
	for i in range(vert_count):
		positions[i] = Vector3(floats[j], floats[j + 1], floats[j + 2])
		colors[i] = Color(floats[j + 3], floats[j + 4], floats[j + 5])
		j += 6

	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = positions
	arrays[Mesh.ARRAY_COLOR] = colors

	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh


static func tile_material() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	# Legacy tiles mix triangle winding (terrain, ribbons, roofs and facades).
	# Java rendered both sides; culling them in Godot opens holes in the world.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mat.roughness = 1.0
	mat.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	return mat


# Collision/height helper data derived from tile metadata.
static func tile_world(tile_id: String) -> Dictionary:
	var meta := load_tile_meta(tile_id)
	if meta.is_empty():
		return {}
	var out := {}
	out["id"] = tile_id
	out["name"] = meta.get("name", "ЮБК")
	out["origin"] = meta.get("origin", [44.55, 33.95])
	out["w"] = int(meta.get("w", 0))
	out["h"] = int(meta.get("h", 0))
	out["dx"] = float(meta.get("dx", 1.0))
	out["dz"] = float(meta.get("dz", 1.0))
	out["heights"] = meta.get("heights", [])
	out["spawn"] = meta.get("spawn", [0.0, 0.0, 0.0])
	out["buildings"] = meta.get("buildings", [])

	var w := int(out["w"])
	var h := int(out["h"])
	out["half_x"] = (w - 1) * float(out["dx"]) / 2.0
	out["half_z"] = (h - 1) * float(out["dz"]) / 2.0

	var nav_path := ROUTE_DIR + tile_id + ".navigation.json"
	if FileAccess.file_exists(nav_path):
		var nav := load_json(nav_path)
		out["roads"] = nav.get("roads", [])
	else:
		out["roads"] = []
	# Spatial lookups keep collision and road snapping cheap on mobile.
	out["road_index"] = {}
	for road in out["roads"]:
		_index_bounds(out["road_index"], minf(road[0], road[2]) - 42.0, minf(road[1], road[3]) - 42.0, maxf(road[0], road[2]) + 42.0, maxf(road[1], road[3]) + 42.0, road)
	out["building_index"] = {}
	for poly in out["buildings"]:
		if poly.size() < 3:
			continue
		var bounds := Rect2(Vector2(poly[0][0], poly[0][1]), Vector2.ZERO)
		for p in poly:
			bounds = bounds.expand(Vector2(p[0], p[1]))
		bounds = bounds.grow(0.6)
		_index_bounds(out["building_index"], bounds.position.x, bounds.position.y, bounds.end.x, bounds.end.y, poly)
	return out


static func _index_bounds(index: Dictionary, x0: float, z0: float, x1: float, z1: float, item: Array) -> void:
	for x in range(int(floor(x0 / 64.0)), int(floor(x1 / 64.0)) + 1):
		for z in range(int(floor(z0 / 64.0)), int(floor(z1 / 64.0)) + 1):
			var key := Vector2i(x, z)
			if not index.has(key):
				index[key] = []
			index[key].append(item)


static func nearby(tile: Dictionary, kind: String, x: float, z: float) -> Array:
	return tile.get(kind + "_index", {}).get(Vector2i(int(floor(x / 64.0)), int(floor(z / 64.0))), [])


static func ground_height(tile: Dictionary, x: float, z: float) -> float:
	var heights = tile.get("heights", [])
	if heights.is_empty():
		return 0.0
	var w := int(tile["w"])
	var h := int(tile["h"])
	var dx := float(tile["dx"])
	var dz := float(tile["dz"])
	var half_x := float(tile["half_x"])
	var half_z := float(tile["half_z"])
	var u := clampf((x + half_x) / dx, 0.0, w - 1.00001)
	var v := clampf((z + half_z) / dz, 0.0, h - 1.00001)
	var c := int(u)
	var r := int(v)
	u -= c
	v -= r
	var row0 = heights[r]
	var row1 = heights[r + 1]
	var a: float
	var b: float
	var cc: float
	var d: float
	if row0 is Array and row1 is Array:
		a = float(row0[c])
		b = float(row0[c + 1])
		cc = float(row1[c])
		d = float(row1[c + 1])
	else:
		a = float(heights[r * w + c])
		b = float(heights[r * w + c + 1])
		cc = float(heights[(r + 1) * w + c])
		d = float(heights[(r + 1) * w + c + 1])
	if u + v <= 1.0:
		return a + (b - a) * u + (cc - a) * v
	return d + (cc - d) * (1.0 - u) + (b - d) * (1.0 - v)


static func point_in_polygon(px: float, pz: float, poly: Array) -> bool:
	var hit := false
	var n := poly.size()
	if n < 3:
		return false
	var j := n - 1
	for i in range(n):
		var pi = poly[i]
		var pj = poly[j]
		var ax := float(pi[0])
		var az := float(pi[1])
		var bx := float(pj[0])
		var bz := float(pj[1])
		if (az > pz) != (bz > pz) and px < (bx - ax) * (pz - az) / (bz - az) + ax:
			hit = not hit
		j = i
	return hit


static func blocked(tile: Dictionary, px: float, pz: float) -> bool:
	var half_x := float(tile["half_x"])
	var half_z := float(tile["half_z"])
	if absf(px) > half_x - 3.0 or absf(pz) > half_z - 3.0:
		return true
	if ground_height(tile, px, pz) < 0.7:
		return true
	for poly in nearby(tile, "building", px, pz):
		if point_in_polygon(px, pz, poly):
			return true
		var n: int = int(poly.size())
		if n < 3:
			continue
		var j: int = n - 1
		for i in range(n):
			var a = poly[i]
			var b = poly[j]
			var ax := float(a[0])
			var az := float(a[1])
			var bx := float(b[0])
			var bz := float(b[1])
			var vx := bx - ax
			var vz := bz - az
			var len := vx * vx + vz * vz
			var t := 0.0
			if len > 0.0:
				t = clampf(((px - ax) * vx + (pz - az) * vz) / len, 0.0, 1.0)
			var ex := px - ax - t * vx
			var ez := pz - az - t * vz
			if ex * ex + ez * ez < 0.25:
				return true
			j = i
	return false
