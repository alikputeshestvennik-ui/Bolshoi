class_name TileLoader
extends RefCounted

# Reads the same tile data as the Java renderer.
# Tile metadata lives in res://assets/route/tile_XX.json and the vertex data is
# generated by tools/sync_assets.py into a single little-endian gzip blob
# res://assets/route/tile_XX.mesh.bin.gz (six float32 per vertex: XYZRGB).

const ROUTE_DIR := "res://assets/route/"

static func load_json(path: String) -> Dictionary:
	var text := FileAccess.get_file_as_string(path)
	if text == "":
		push_error("Missing " + path)
		return {}
	var data = JSON.parse_string(text)
	if typeof(data) != TYPE_DICTIONARY:
		push_error("Invalid JSON " + path)
		return {}
	return data


static func load_region() -> Dictionary:
	return load_json(ROUTE_DIR + "region.mobile.json")


static func load_tile_meta(tile_id: String) -> Dictionary:
	return load_json(ROUTE_DIR + tile_id + ".json")


static func load_vertex_arrays(path: String, max_vertices: int, expected_vertices: int = -1) -> Array:
	var raw := FileAccess.get_file_as_bytes(path)
	if raw.is_empty():
		push_error("Missing mesh blob: " + path)
		return []
	var buf := raw.decompress_dynamic(max_vertices * 24, FileAccess.COMPRESSION_GZIP)
	if buf.is_empty() or buf.size() % 72 != 0:
		push_error("Invalid mesh blob: " + path)
		return []
	var floats := buf.to_float32_array()
	var vert_count := int(floats.size() / 6)
	if vert_count > max_vertices or (expected_vertices >= 0 and vert_count != expected_vertices):
		push_error("Mesh exceeds its declared budget: " + path)
		return []

	var positions := PackedVector3Array()
	var colors := PackedColorArray()
	positions.resize(vert_count)
	colors.resize(vert_count)
	var j := 0
	for i in range(vert_count):
		positions[i] = Vector3(floats[j], floats[j + 1], floats[j + 2])
		colors[i] = Color(floats[j + 3], floats[j + 4], floats[j + 5])
		j += 6

	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = positions
	arrays[Mesh.ARRAY_COLOR] = colors
	return arrays


static func mesh_from_arrays(arrays: Array) -> ArrayMesh:
	if arrays.is_empty():
		return null

	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh


static func load_tile_mesh(tile_id: String) -> ArrayMesh:
	# Only the inexpensive distant terrain is loaded synchronously. Detailed
	# geometry goes through WorldStream's single background decoder.
	return mesh_from_arrays(load_vertex_arrays(ROUTE_DIR + tile_id + ".far.bin.gz", 100000))


static func load_map_batches(manifest: Dictionary) -> Array:
	var expected := int(manifest.get("float_count", 0))
	if expected <= 0 or expected > 16000000:
		push_error("Invalid mobile map size")
		return []
	var raw := FileAccess.get_file_as_bytes(ROUTE_DIR + "region.lines.bin.gz")
	var bytes := raw.decompress_dynamic(expected * 4, FileAccess.COMPRESSION_GZIP)
	if bytes.size() != expected * 4:
		push_error("Invalid mobile map data")
		return []
	var floats := bytes.to_float32_array()
	var result: Array = []
	for batch in manifest.get("batches", []):
		var start := int(batch["start"])
		var count := int(batch["count"])
		if start < 0 or count <= 0 or count % 4 != 0 or start + count > floats.size():
			push_error("Invalid map batch bounds")
			return []
		var points := PackedVector2Array()
		points.resize(int(count / 2))
		for i in range(points.size()):
			points[i] = Vector2(floats[start + i * 2], floats[start + i * 2 + 1])
		result.append({"kind": batch["kind"], "bounds": batch["bounds"], "points": points, "lod_min": batch.get("lod_min", 1), "lod_max": batch.get("lod_max", 65)})
	return result


static func tile_material() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	# Legacy tiles mix triangle winding (terrain, ribbons, roofs and facades).
	# Java rendered both sides; culling them in Godot opens holes in the world.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mat.roughness = 1.0
	mat.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	return mat


# Collision/height helper data derived from tile metadata.
static func tile_world(tile_id: String) -> Dictionary:
	var meta := load_tile_meta(tile_id)
	if meta.is_empty():
		return {}
	var out := {}
	out["id"] = tile_id
	out["name"] = meta.get("name", "ЮБК")
	out["origin"] = meta.get("origin", [44.55, 33.95])
	out["center_x"] = float(meta.get("center_x", 0.0))
	out["center_z"] = float(meta.get("center_z", 0.0))
	out["w"] = int(meta.get("w", 0))
	out["h"] = int(meta.get("h", 0))
	out["dx"] = float(meta.get("dx", 1.0))
	out["dz"] = float(meta.get("dz", 1.0))
	out["heights"] = meta.get("heights", [])
	out["spawn"] = meta.get("spawn", [0.0, 0.0, 0.0])
	out["buildings"] = meta.get("buildings", [])

	var w := int(out["w"])
	var h := int(out["h"])
	out["half_x"] = (w - 1) * float(out["dx"]) / 2.0
	out["half_z"] = (h - 1) * float(out["dz"]) / 2.0

	var nav_path := ROUTE_DIR + tile_id + ".navigation.json"
	if FileAccess.file_exists(nav_path):
		var nav := load_json(nav_path)
		out["roads"] = nav.get("roads", [])
	else:
		out["roads"] = []
	# Actual joined pavement quads, generated alongside the repaired mesh.
	var surface_path := ROUTE_DIR + tile_id + ".roads.bin.gz"
	out["surfaces"] = PackedFloat32Array()
	out["surface_index"] = {}
	if FileAccess.file_exists(surface_path):
		var packed := FileAccess.get_file_as_bytes(surface_path)
		var bytes := packed.decompress_dynamic(128 << 20, FileAccess.COMPRESSION_GZIP)
		var surfaces := bytes.to_float32_array()
		if surfaces.size() % 12 == 0:
			out["surfaces"] = surfaces
			for offset in range(0, surfaces.size(), 12):
				var x0 := INF
				var z0 := INF
				var x1 := -INF
				var z1 := -INF
				for corner in range(4):
					var i := offset + corner * 3
					x0 = minf(x0, surfaces[i])
					z0 = minf(z0, surfaces[i + 2])
					x1 = maxf(x1, surfaces[i])
					z1 = maxf(z1, surfaces[i + 2])
				for x in range(int(floor(x0 / 64.0)), int(floor(x1 / 64.0)) + 1):
					for z in range(int(floor(z0 / 64.0)), int(floor(z1 / 64.0)) + 1):
						var key := Vector2i(x, z)
						if not out["surface_index"].has(key):
							out["surface_index"][key] = []
						out["surface_index"][key].append(offset)
	# Spatial lookups keep collision and road snapping cheap on mobile.
	out["road_index"] = {}
	for road in out["roads"]:
		_index_bounds(out["road_index"], minf(road[0], road[2]) - 42.0, minf(road[1], road[3]) - 42.0, maxf(road[0], road[2]) + 42.0, maxf(road[1], road[3]) + 42.0, road)
	out["building_index"] = {}
	for poly in out["buildings"]:
		if poly.size() < 3:
			continue
		var bounds := Rect2(Vector2(poly[0][0], poly[0][1]), Vector2.ZERO)
		for p in poly:
			bounds = bounds.expand(Vector2(p[0], p[1]))
		bounds = bounds.grow(0.6)
		_index_bounds(out["building_index"], bounds.position.x, bounds.position.y, bounds.end.x, bounds.end.y, poly)
	return out


static func _index_bounds(index: Dictionary, x0: float, z0: float, x1: float, z1: float, item: Array) -> void:
	for x in range(int(floor(x0 / 64.0)), int(floor(x1 / 64.0)) + 1):
		for z in range(int(floor(z0 / 64.0)), int(floor(z1 / 64.0)) + 1):
			var key := Vector2i(x, z)
			if not index.has(key):
				index[key] = []
			index[key].append(item)


static func nearby(tile: Dictionary, kind: String, x: float, z: float) -> Array:
	return tile.get(kind + "_index", {}).get(Vector2i(int(floor(x / 64.0)), int(floor(z / 64.0))), [])


static func ground_height(tile: Dictionary, x: float, z: float) -> float:
	var heights = tile.get("heights", [])
	if heights.is_empty():
		return 0.0
	var w := int(tile["w"])
	var h := int(tile["h"])
	var dx := float(tile["dx"])
	var dz := float(tile["dz"])
	var half_x := float(tile["half_x"])
	var half_z := float(tile["half_z"])
	var u := clampf((x - float(tile.get("center_x", 0.0)) + half_x) / dx, 0.0, w - 1.00001)
	var v := clampf((z - float(tile.get("center_z", 0.0)) + half_z) / dz, 0.0, h - 1.00001)
	var c := int(u)
	var r := int(v)
	u -= c
	v -= r
	var row0 = heights[r]
	var row1 = heights[r + 1]
	var a: float
	var b: float
	var cc: float
	var d: float
	if row0 is Array and row1 is Array:
		a = float(row0[c])
		b = float(row0[c + 1])
		cc = float(row1[c])
		d = float(row1[c + 1])
	else:
		a = float(heights[r * w + c])
		b = float(heights[r * w + c + 1])
		cc = float(heights[(r + 1) * w + c])
		d = float(heights[(r + 1) * w + c + 1])
	if u + v <= 1.0:
		return a + (b - a) * u + (cc - a) * v
	return d + (cc - d) * (1.0 - u) + (b - d) * (1.0 - v)


static func pavement_height(tile: Dictionary, x: float, z: float, reference_y: float = NAN) -> float:
	var ground := ground_height(tile, x, z)
	var surfaces: PackedFloat32Array = tile.get("surfaces", PackedFloat32Array())
	var offsets: Array = tile.get("surface_index", {}).get(Vector2i(int(floor(x / 64.0)), int(floor(z / 64.0))), [])
	var heights: Array[float] = []
	for offset in offsets:
		for triangle in [[0, 3, 6], [0, 6, 9]]:
			var ia: int = offset + triangle[0]
			var ib: int = offset + triangle[1]
			var ic: int = offset + triangle[2]
			var denominator := (surfaces[ib + 2] - surfaces[ic + 2]) * (surfaces[ia] - surfaces[ic]) + (surfaces[ic] - surfaces[ib]) * (surfaces[ia + 2] - surfaces[ic + 2])
			if absf(denominator) < 0.00001:
				continue
			var u := ((surfaces[ib + 2] - surfaces[ic + 2]) * (x - surfaces[ic]) + (surfaces[ic] - surfaces[ib]) * (z - surfaces[ic + 2])) / denominator
			var v := ((surfaces[ic + 2] - surfaces[ia + 2]) * (x - surfaces[ic]) + (surfaces[ia] - surfaces[ic]) * (z - surfaces[ic + 2])) / denominator
			if u >= -0.0001 and v >= -0.0001 and u + v <= 1.0001:
				heights.append(u * surfaces[ia + 1] + v * surfaces[ib + 1] + (1.0 - u - v) * surfaces[ic + 1])
				break
	if heights.is_empty():
		return ground
	if is_nan(reference_y):
		return heights.max()
	# At overpasses, stay on the same level; within a road layer use the top
	# asphalt surface rather than its slightly lower shoulder.
	var nearest := heights[0]
	for height in heights:
		if absf(height - reference_y) < absf(nearest - reference_y):
			nearest = height
	var top := nearest
	for height in heights:
		if absf(height - nearest) < 0.6:
			top = maxf(top, height)
	return top


static func point_in_polygon(px: float, pz: float, poly: Array) -> bool:
	var hit := false
	var n := poly.size()
	if n < 3:
		return false
	var j := n - 1
	for i in range(n):
		var pi = poly[i]
		var pj = poly[j]
		var ax := float(pi[0])
		var az := float(pi[1])
		var bx := float(pj[0])
		var bz := float(pj[1])
		if (az > pz) != (bz > pz) and px < (bx - ax) * (pz - az) / (bz - az) + ax:
			hit = not hit
		j = i
	return hit


static func blocked(tile: Dictionary, px: float, pz: float) -> bool:
	var half_x := float(tile["half_x"])
	var half_z := float(tile["half_z"])
	if absf(px - float(tile.get("center_x", 0.0))) > half_x or absf(pz - float(tile.get("center_z", 0.0))) > half_z:
		return true
	if ground_height(tile, px, pz) < 0.7:
		return true
	for poly in nearby(tile, "building", px, pz):
		if point_in_polygon(px, pz, poly):
			return true
		var n: int = int(poly.size())
		if n < 3:
			continue
		var j: int = n - 1
		for i in range(n):
			var a = poly[i]
			var b = poly[j]
			var ax := float(a[0])
			var az := float(a[1])
			var bx := float(b[0])
			var bz := float(b[1])
			var vx := bx - ax
			var vz := bz - az
			var len := vx * vx + vz * vz
			var t := 0.0
			if len > 0.0:
				t = clampf(((px - ax) * vx + (pz - az) * vz) / len, 0.0, 1.0)
			var ex := px - ax - t * vx
			var ez := pz - az - t * vz
			if ex * ex + ez * ez < 0.25:
				return true
			j = i
	return false
